# Только локальная учебная среда; эти пароли публичны.
WEB_PORT=8080
POSTGRES_PORT=5432
# Для pnpm-команд вне Docker (Compose использует внутренний postgres hostname).
DATABASE_URL=postgresql://finora_runtime:finora_local_runtime@127.0.0.1:5432/finora
MIGRATION_DATABASE_URL=postgresql://finora_migrator:finora_local_migrator@127.0.0.1:5432/finora
# Фиксированная временная опора для воспроизводимых демонстраций и тестов.
# Если не задана, первый seed выбирает текущий месяц; restart не сдвигает историю.
SEED_ANCHOR_DATE=2026-09-01
