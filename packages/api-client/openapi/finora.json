  "info": {
    "title": "Finora API",
    "description": "Finora: авторизация и настройки профиля. Изменяющие запросы требуют разрешённый Origin. Сессия: HttpOnly cookie, 24 часа.",
    "version": "0.4.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "finora_session"
      }
    },
    "schemas": {
      "ProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Категория ошибки",
            "example": "internal_error"
          },
          "title": {
            "type": "string",
            "description": "Краткое описание ошибки"
          },
          "status": {
            "type": "number",
            "description": "HTTP-статус"
          },
          "detail": {
            "type": "string",
            "description": "Безопасное описание причины"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Ошибки полей"
          },
          "traceId": {
            "type": "string",
            "description": "Идентификатор запроса"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "errors",
          "traceId"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "Состояние инфраструктуры"
          }
        },
        "required": [
          "status"
        ]
      },
      "RegisterInputDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Имя профиля",
            "minLength": 1,
            "maxLength": 100
          },
          "baseCurrency": {
            "type": "string",
            "description": "Код основной валюты из /settings/options",
            "example": "RUB"
          },
          "timeZone": {
            "type": "string",
            "description": "Часовой пояс IANA из /settings/options",
            "example": "Europe/Moscow"
          },
          "email": {
            "type": "string",
            "description": "Email нового пользователя",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "description": "Пароль от 12 до 128 символов",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "displayName",
          "baseCurrency",
          "timeZone",
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Имя профиля",
            "minLength": 1,
            "maxLength": 100
          },
          "baseCurrency": {
            "type": "string",
            "description": "Код основной валюты из /settings/options",
            "example": "RUB"
          },
          "timeZone": {
            "type": "string",
            "description": "Часовой пояс IANA из /settings/options",
            "example": "Europe/Moscow"
          },
          "id": {
            "type": "string",
            "description": "Идентификатор текущего пользователя",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Нормализованный email",
            "format": "email"
          },
          "baseCurrencyLocked": {
            "type": "boolean",
            "description": "Основная валюта заблокирована финансовыми данными или их историей"
          }
        },
        "required": [
          "displayName",
          "baseCurrency",
          "timeZone",
